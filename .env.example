# Copy this file to .env and configure your model provider.
# For a relay, use the API Base URL and model ID supplied by that provider.
# Leave the protocol as auto unless the provider requires a specific API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_PROTOCOL=auto
