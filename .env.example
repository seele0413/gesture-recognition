# AI workflow generator: accepts official OpenAI or an OpenAI-compatible gateway.
# Copy this file to .env. Keep the API key private and never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# auto | chat_completions | responses
OPENAI_API_PROTOCOL=auto
